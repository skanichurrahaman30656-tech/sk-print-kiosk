rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all unspecified routes
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPrintJob(data) {
      return data.tokenNumber is string && data.tokenNumber.size() > 0 && data.tokenNumber.size() <= 32
        && data.documentName is string && data.documentName.size() > 0 && data.documentName.size() <= 200
        && data.docCategory is string && (data.docCategory == '5' || data.docCategory == '10')
        && data.pages is number && data.pages >= 1 && data.pages <= 1000
        && data.copies is number && data.copies >= 1 && data.copies <= 500
        && data.totalCost is number && data.totalCost >= 0 && data.totalCost <= 50000
        && data.status is string && (data.status == 'pending' || data.status == 'printing' || data.status == 'completed')
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Public Kiosk Print Jobs
    match /printJobs/{jobId} {
      allow get, list: if true;
      allow create: if isValidId(jobId) && isValidPrintJob(request.resource.data);
      allow update: if isValidId(jobId) && isValidPrintJob(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.tokenNumber == resource.data.tokenNumber;
      allow delete: if false;
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }
  }
}
